+    /// Create a hard link: add a directory entry `name` pointing to `inode_id` in this (directory) inode
+    pub fn link(&self, name: &str, inode_id: u32) {
+        let mut fs = self.fs.lock();
+        self.modify_disk_inode(|root_inode| {
+            assert!(root_inode.is_dir());
+            let file_count = (root_inode.size as usize) / DIRENT_SZ;
+            let new_size = (file_count + 1) * DIRENT_SZ;
+            self.increase_size(new_size as u32, root_inode, &mut fs);
+            let dirent = DirEntry::new(name, inode_id);
+            root_inode.write_at(
+                file_count * DIRENT_SZ,
+                dirent.as_bytes(),
+                &self.block_device,
+            );
+        });
+        // increment nlink on the target inode
+        let (block_id, block_offset) = fs.get_disk_inode_pos(inode_id);
+        get_block_cache(block_id as usize, Arc::clone(&self.block_device))
+            .lock()
+            .modify(block_offset, |disk_inode: &mut DiskInode| {
+                disk_inode.nlink += 1;
+            });
+        block_cache_sync_all();
+    }
+
+    /// Remove a directory entry by name. Decrements nlink on the target inode.
+    pub fn unlink(&self, name: &str) -> i32 {
+        let fs = self.fs.lock();
+        let inode_id = self.read_disk_inode(|disk_inode| {
+            self.find_inode_id(name, disk_inode)
+        });
+        if inode_id.is_none() {
+            return -1;
+        }
+        let inode_id = inode_id.unwrap();
+        // remove directory entry by replacing with empty
+        self.modify_disk_inode(|disk_inode| {
+            let file_count = (disk_inode.size as usize) / DIRENT_SZ;
+            let mut dirent = DirEntry::empty();
+            for i in 0..file_count {
+                disk_inode.read_at(DIRENT_SZ * i, dirent.as_bytes_mut(), &self.block_device);
+                if dirent.name() == name {
+                    // replace with the last entry
+                    let mut last_dirent = DirEntry::empty();
+                    if i < file_count - 1 {
+                        disk_inode.read_at(DIRENT_SZ * (file_count - 1), last_dirent.as_bytes_mut(), &self.block_device);
+                        disk_inode.write_at(DIRENT_SZ * i, last_dirent.as_bytes(), &self.block_device);
+                    }
+                    // write empty entry at the last position
+                    let empty = DirEntry::empty();
+                    disk_inode.write_at(DIRENT_SZ * (file_count - 1), empty.as_bytes(), &self.block_device);
+                    // shrink size
+                    disk_inode.size -= DIRENT_SZ as u32;
+                    break;
+                }
+            }
+        });
+        // decrement nlink
+        let (block_id, block_offset) = fs.get_disk_inode_pos(inode_id);
+        get_block_cache(block_id as usize, Arc::clone(&self.block_device))
+            .lock()
+            .modify(block_offset, |disk_inode: &mut DiskInode| {
+                if disk_inode.nlink > 0 {
+                    disk_inode.nlink -= 1;
+                }
+            });
+        block_cache_sync_all();
+        0
+    }
