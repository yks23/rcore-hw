+    /// Map a new framed area [start_va, end_va). Returns 0 on success, -1 on failure.
+    pub fn mmap(&mut self, start_va: VirtAddr, end_va: VirtAddr, permission: MapPermission) -> isize {
+        let start_vpn = start_va.floor();
+        let end_vpn = end_va.ceil();
+        for vpn in VPNRange::new(start_vpn, end_vpn) {
+            if let Some(pte) = self.page_table.translate(vpn) {
+                if pte.is_valid() {
+                    return -1;
+                }
+            }
+        }
+        self.insert_framed_area(start_va, end_va, permission);
+        0
+    }
+
+    /// Unmap the area covering [start_va, end_va). Returns 0 on success, -1 on failure.
+    pub fn munmap(&mut self, start_va: VirtAddr, end_va: VirtAddr) -> isize {
+        let start_vpn = start_va.floor();
+        let end_vpn = end_va.ceil();
+        for vpn in VPNRange::new(start_vpn, end_vpn) {
+            match self.page_table.translate(vpn) {
+                Some(pte) if pte.is_valid() => {}
+                _ => return -1,
+            }
+        }
+        if let Some(idx) = self.areas.iter().position(|area| {
+            area.vpn_range.get_start() == start_vpn && area.vpn_range.get_end() == end_vpn
+        }) {
+            self.areas[idx].unmap(&mut self.page_table);
+            self.areas.remove(idx);
+            0
+        } else {
+            for vpn in VPNRange::new(start_vpn, end_vpn) {
+                self.page_table.unmap(vpn);
+            }
+            self.areas.retain(|area| {
+                !(area.vpn_range.get_start() >= start_vpn && area.vpn_range.get_end() <= end_vpn)
+            });
+            0
+        }
+    }
