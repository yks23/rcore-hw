-    -1
+/// Check whether an address is valid in ch3 (no virtual memory, shared physical space).
+fn is_valid_user_addr(addr: usize) -> bool {
+    addr != 0 && addr < MEMORY_END
+}
+
+/// Trace syscall: read/write user memory or count syscall invocations.
+///
+/// - `trace_request = 0` (Read): read one byte from user address `id`
+/// - `trace_request = 1` (Write): write `data as u8` to user address `id`
+/// - `trace_request = 2` (Syscall): return the count of syscall `id` for current task
+pub fn sys_trace(trace_request: usize, id: usize, data: usize) -> isize {
+    match trace_request {
+        // Read
+        0 => {
+            if !is_valid_user_addr(id) {
+                return -1;
+            }
+            let byte = unsafe { *(id as *const u8) };
+            byte as isize
+        }
+        // Write
+        1 => {
+            if !is_valid_user_addr(id) {
+                return -1;
+            }
+            unsafe {
+                *(id as *mut u8) = data as u8;
+            }
+            0
+        }
+        // Syscall count
+        2 => get_syscall_count(id) as isize,
+        _ => -1,
+    }
 }
