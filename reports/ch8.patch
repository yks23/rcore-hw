+/// Check for deadlock using wait-for graph cycle detection.
+/// Thread `tid` wants to acquire sem `sem_id` and would block.
+/// Check if this creates a circular wait.
+fn detect_semaphore_deadlock(
+    sem_alloc: &[Vec<usize>],
+    sem_waiting: &[Option<usize>],
+    tid: usize,
+    sem_id: usize,
+) -> bool {
+    let n_threads = sem_alloc.len().max(sem_waiting.len()).max(tid + 1);
+    let mut visited = vec![false; n_threads];
+    let mut stack = Vec::new();
+    // tid is waiting for sem_id
+    // Find all holders of sem_id
+    visited[tid] = true;
+    for t in 0..n_threads {
+        if t < sem_alloc.len()
+            && sem_id < sem_alloc[t].len()
+            && sem_alloc[t][sem_id] > 0
+            && t != tid
+        {
+            stack.push(t);
+        }
+    }
+    // BFS/DFS through the wait-for graph
+    while let Some(holder) = stack.pop() {
+        if holder == tid {
+            return true; // Cycle found
+        }
+        if holder >= n_threads || visited[holder] {
+            continue;
+        }
+        visited[holder] = true;
+        // What is this holder waiting for?
+        let waiting = if holder < sem_waiting.len() {
+            sem_waiting[holder]
+        } else {
+            None
+        };
+        if let Some(wanted_sem) = waiting {
+            // This holder is blocked on wanted_sem
+            // Find who holds wanted_sem
+            for t in 0..n_threads {
+                if t < sem_alloc.len()
+                    && wanted_sem < sem_alloc[t].len()
+                    && sem_alloc[t][wanted_sem] > 0
+                    && !visited[t]
+                {
+                    stack.push(t);
+                }
+            }
+        }
+        // If holder is NOT waiting, it can eventually release, no cycle through it
+    }
+    false
+}
