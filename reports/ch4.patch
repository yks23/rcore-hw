+/// Increment the syscall count for the current task.
+pub fn inc_syscall_count(syscall_id: usize) {
+    let mut inner = TASK_MANAGER.inner.exclusive_access();
+    let cur = inner.current_task;
+    if syscall_id < MAX_SYSCALL_NUM {
+        inner.tasks[cur].syscall_counts[syscall_id] += 1;
+    }
+}
+
+/// Get the syscall count for the current task.
+pub fn get_syscall_count(syscall_id: usize) -> u32 {
+    let inner = TASK_MANAGER.inner.exclusive_access();
+    let cur = inner.current_task;
+    if syscall_id < MAX_SYSCALL_NUM {
+        inner.tasks[cur].syscall_counts[syscall_id]
+    } else {
+        0
+    }
+}
+
+/// Mmap for current task's memory set.
+pub fn current_mmap(start: usize, len: usize, perm: MapPermission) -> isize {
+    let mut inner = TASK_MANAGER.inner.exclusive_access();
+    let cur = inner.current_task;
+    let start_va = VirtAddr::from(start);
+    let end_va = VirtAddr::from(start + len);
+    inner.tasks[cur].memory_set.mmap(start_va, end_va, perm)
+}
+
